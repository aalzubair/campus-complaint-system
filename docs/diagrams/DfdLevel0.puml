@startuml DfdLevel0
left to right direction
skinparam nodesep 40
skinparam ranksep 100
skinparam dpi 300

rectangle "Complainant\n(Student,\nFaculty Member,\nAdministrator)" as C
rectangle "Maintenance\nStaff" as S
rectangle "Maintenance\nSupervisor" as V
rectangle "IUB\nRecords" as R
rectangle "Message\nDelivery\nService" as M
rectangle "University\nAdministration" as A

usecase "\n\n\n\n\n0\n\nCampus Complaint and\nMaintenance System\n\n\n\n\n\n" as P

C --> P : registration and login details,\ncomplaint, follow and reopen requests
P -[norank]-> C : complaint status,\nnotifications, messages
S --> P : filter, accept, resolve\nand reject requests
P -[norank]-> S : complaint list, location history,\nnotifications
V --> P : assign, resolve, reject\nand monitor requests
P -[norank]-> V : complaint overview,\noverdue and hazard alerts
P --> R : ID lookup request
R -[norank]-> P : ID, role, email and mobile number
P --> M : OTP and Safety Hazard messages
A -[norank]-> P : report request (date range)
P --> A : resolution-time report,\nfrequency report
@enduml